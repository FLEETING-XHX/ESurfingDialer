# 实验版，未完成Docker ARM32/2082原生等价与现场验收。首次使用前读README。
NATIVE_EXPERIMENTAL=0
# 沿用旧版周期学习重认证；窗口固定UTC+8，不是每天重启功能。
AUTO_REAUTH_ENABLED=1
AUTO_REAUTH_SAFE_WINDOW_START_HOUR=4
AUTO_REAUTH_SAFE_WINDOW_END_HOUR=6
# 可显式覆盖旧device-state.json；两项均留空时保留已存身份。
DIALER_MAC_ADDRESS=
DIALER_CLIENT_ID=
DIALER_USER=
# 推荐由容器secret挂载后设置DIALER_PASSWORD_FILE；不要把密码写入命令行。
DIALER_PASSWORD=
TZ=Asia/Shanghai
# 文件日志独立于Docker json-file轮转。默认目录为STATE_DIR/logs，必须可写且专用。
# LOG_DIR=/data/logs
LOG_RETENTION_DAYS=3
LOG_FILE_MAX_BYTES=10485760
LOG_TOTAL_MAX_BYTES=52428800
LOG_ROTATED_FILES=2
