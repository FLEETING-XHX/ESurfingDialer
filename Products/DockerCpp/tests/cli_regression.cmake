file(MAKE_DIRECTORY "${WORK}")
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef identity)
set(state "${WORK}/must-not-exist-${identity}")
set(count 0)
function(check_cli expected)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env NATIVE_EXPERIMENTAL=1 "STATE_DIR=${state}" DIALER_USER=synthetic-account-MUST-NOT-LOG DIALER_PASSWORD=synthetic-password-MUST-NOT-LOG "${BINARY}" ${ARGN}
    RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 2)
  if(NOT "${code}" STREQUAL "${expected}")
    message(FATAL_ERROR "CLI exit code ${code}; expected ${expected}")
  endif()
  if(EXISTS "${state}")
    message(FATAL_ERROR "CLI touched state before rejecting arguments")
  endif()
  string(CONCAT text "${out}" "${err}")
  if(text MATCHES "MUST-NOT-LOG|secret|http://|ticket=|StackTrace|Exception")
    message(FATAL_ERROR "CLI disclosed supplied argument/environment data")
  endif()
  if(expected EQUAL 64 AND NOT text MATCHES "NATIVE_ARGUMENTS_UNSUPPORTED")
    message(FATAL_ERROR "Unsupported arguments lack fixed diagnostic")
  endif()
endfunction()
check_cli(0 --version)
check_cli(64 --help)
check_cli(64 --user=synthetic-account-MUST-NOT-LOG --password=synthetic-password-MUST-NOT-LOG)
check_cli(64 --diagnose-portal "http://secret.invalid/?ticket=secret")
check_cli(64 --version --password=synthetic-password-MUST-NOT-LOG)
check_cli(64 --unknown)
message(STATUS "6 CLI cases passed: fixed diagnostics, no credential/argv disclosure, no state or authentication startup")
