# Formal v3.0.0 does not require an experimental opt-in flag.
# Optional private bootstrap capture. Keep disabled for normal use.
NATIVE_CAPTURE_BOOTSTRAP=0
# Restart once per UTC+8 day, at the first check inside this allowed window.
# Missed windows are skipped. Docker restart policy must be unless-stopped.
DAILY_RESTART_ENABLED=1
DAILY_RESTART_SAFE_WINDOW_START_HOUR=4
DAILY_RESTART_SAFE_WINDOW_END_HOUR=6
# Leave blank to preserve stored device identity.
DIALER_MAC_ADDRESS=
DIALER_CLIENT_ID=
DIALER_USER=
# DIALER_PASSWORD_FILE may point to a mounted secret instead.
DIALER_PASSWORD=
TZ=Asia/Shanghai
# Compose binds ./log on the host to /data/logs. Keep the default directory.
# LOG_DIR=/data/logs
# Local calendar dates to keep, including today; cleaned hourly and at midnight.
LOG_RETENTION_DAYS=3
LOG_FILE_MAX_BYTES=10485760
LOG_TOTAL_MAX_BYTES=52428800
LOG_ROTATED_FILES=2

# Optional OpenWrt WAN device names; empty means IPv4 default-route candidate only.
# Use real kernel device names, not the UCI logical section name.
WAN_INTERFACE=
WAN_PHYSICAL_INTERFACE=
