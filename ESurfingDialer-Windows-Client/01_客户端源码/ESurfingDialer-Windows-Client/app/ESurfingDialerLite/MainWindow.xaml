<Window x:Class="ESurfingDialerLite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ESurfingDialer Lite"
        Width="520"
        Height="620"
        MinWidth="480"
        MinHeight="560"
        Background="#F3F5F7"
        Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="ESurfingDialer Lite" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Text="天翼校园轻量认证客户端" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <Border DockPanel.Dock="Right" Padding="10,5" CornerRadius="4" Background="#E7EEF8">
                <TextBlock x:Name="StatusText" Text="未连接" FontWeight="SemiBold" Foreground="#214C7A"/>
            </Border>
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="账号" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <TextBox x:Name="UserTextBox" Grid.Row="0" Grid.Column="1"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="密码" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <PasswordBox x:Name="PasswordBox" Grid.Row="2" Grid.Column="1"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="选项" VerticalAlignment="Top" FontWeight="SemiBold"/>
            <StackPanel Grid.Row="4" Grid.Column="1">
                <CheckBox x:Name="AutoStartCheckBox" Content="开机自启" Margin="0,0,0,8"/>
                <CheckBox x:Name="StartMinimizedCheckBox" Content="启动后最小化到托盘" Margin="0,0,0,8"/>
                <CheckBox x:Name="AutoConnectCheckBox" Content="启动后自动连接"/>
            </StackPanel>
        </Grid>

        <WrapPanel Grid.Row="2" Margin="0,0,0,18">
            <Button x:Name="ConnectButton" Content="连接" Click="ConnectButton_Click"/>
            <Button x:Name="DisconnectButton" Content="断开" Click="DisconnectButton_Click"/>
            <Button Content="保存配置" Click="SaveButton_Click"/>
            <Button Content="打开日志" Click="OpenLogsButton_Click"/>
            <Button Content="导出日志包" Click="ExportLogsButton_Click"/>
        </WrapPanel>

        <Border Grid.Row="3" Background="White" BorderBrush="#D8DEE8" BorderThickness="1" CornerRadius="6" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="运行日志" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock x:Name="HealthTextBlock"
                           Grid.Row="1"
                           Text="健康状态：等待核心启动"
                           Foreground="{StaticResource MutedTextBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"/>
                <TextBox x:Name="LogTextBox"
                         Grid.Row="2"
                         FontFamily="Consolas"
                         FontSize="12"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"/>
            </Grid>
        </Border>

        <DockPanel Grid.Row="4" Margin="0,14,0,0">
            <TextBlock DockPanel.Dock="Left"
                       Text="免费开源项目"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource MutedTextBrush}"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}">
                    <Hyperlink NavigateUri="https://github.com/Itsuwarii/ESurfingDialer"
                               RequestNavigate="SourceLink_RequestNavigate">
                        感谢 Itsuwarii 大佬的开源
                    </Hyperlink>
                </TextBlock>
                <Button Content="退出" Click="ExitButton_Click" Margin="12,0,0,0"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
